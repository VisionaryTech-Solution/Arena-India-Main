# Copy to .env.local and restart `npm run dev`.
# For the deployed site, set the same variable in your host's dashboard (Netlify / Vercel / Cloudflare Pages) and redeploy,
# because Vite bakes VITE_ values in at build time.
#
# Public URL of the read-only JSON endpoint that returns events: the n8n *Production* URL of the Events API workflow, e.g.
#   https://YOUR-N8N-HOST/webhook/arena-events
# (NOT the /webhook-test/ URL.) NEVER put credentials or secrets here;
# anything in a VITE_ variable is visible to every visitor.
# Leave empty to use the built-in demo data.
VITE_EVENTS_API_URL=

# During `npm run dev` demo data is used automatically if the API fails.
# Set to true to allow the same fallback in a production build (otherwise users see an error with a Retry button).
VITE_ALLOW_MOCK_FALLBACK=false
